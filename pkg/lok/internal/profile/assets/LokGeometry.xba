<?xml version="1.0" encoding="UTF-8"?>
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="LokGeometry" script:language="StarBasic">
&apos; Prepares the loaded document(s) before PDF export. LibreOfficeKit cannot
&apos; mutate a document through a UNO dispatch in headless mode, so this UNO macro
&apos; does it directly. Parameters arrive through environment variables:
&apos;   LOK_GEOM = &quot;landscape,width,height&quot; (landscape 0/1, size in 1/100 mm,
&apos;              0 keeps the current size).
&apos;   LOK_UPDATE_INDEXES = &quot;1&quot; refreshes fields and updates document indexes.
&apos;   LOK_DISABLE_CALC_HEADER = &quot;1&quot; turns off spreadsheet page headers.
&apos;   LOK_SHOW_CHANGES = &quot;0&quot; accepts tracked changes in text documents.
Sub Prepare
  Dim geom, doIdx, noHeader, hideChanges, parts, bLand, nW, nH, hasGeom
  Dim oEnum, oDoc, oFam, oStyles, oStyle, i, tmp, oIndexes, j, oDisp
  geom = Environ(&quot;LOK_GEOM&quot;)
  doIdx = (Environ(&quot;LOK_UPDATE_INDEXES&quot;) = &quot;1&quot;)
  noHeader = (Environ(&quot;LOK_DISABLE_CALC_HEADER&quot;) = &quot;1&quot;)
  hideChanges = (Environ(&quot;LOK_SHOW_CHANGES&quot;) = &quot;0&quot;)
  hasGeom = False
  If geom &lt;&gt; &quot;&quot; Then
    parts = Split(geom, &quot;,&quot;)
    If UBound(parts) &gt;= 2 Then
      bLand = (Trim(parts(0)) = &quot;1&quot;)
      nW = CLng(parts(1))
      nH = CLng(parts(2))
      hasGeom = (bLand Or (nW &gt; 0 And nH &gt; 0))
    End If
  End If
  If (Not hasGeom) And (Not doIdx) And (Not noHeader) And (Not hideChanges) Then Exit Sub
  oEnum = StarDesktop.Components.createEnumeration()
  Do While oEnum.hasMoreElements()
    oDoc = oEnum.nextElement()
    If hasGeom And HasUnoInterfaces(oDoc, &quot;com.sun.star.style.XStyleFamiliesSupplier&quot;) Then
      oFam = oDoc.StyleFamilies
      If oFam.hasByName(&quot;PageStyles&quot;) Then
        oStyles = oFam.getByName(&quot;PageStyles&quot;)
        For i = 0 To oStyles.Count - 1
          oStyle = oStyles.getByIndex(i)
          If oStyle.isInUse() Then
            If nW &gt; 0 And nH &gt; 0 Then
              oStyle.IsLandscape = bLand
              oStyle.Width = nW
              oStyle.Height = nH
            ElseIf bLand Then
              If oStyle.Width &lt; oStyle.Height Then
                tmp = oStyle.Width : oStyle.Width = oStyle.Height : oStyle.Height = tmp
              End If
              oStyle.IsLandscape = True
            End If
          End If
        Next i
      End If
    End If
    If noHeader And HasUnoInterfaces(oDoc, &quot;com.sun.star.sheet.XSpreadsheetDocument&quot;) Then
      oStyles = oDoc.StyleFamilies.getByName(&quot;PageStyles&quot;)
      For i = 0 To oStyles.Count - 1
        oStyles.getByIndex(i).HeaderIsOn = False
      Next i
    End If
    &apos; Setting ShowChanges to False does not reach the PDF export, so accept
    &apos; the changes instead: the export then matches the hidden-changes view.
    If hideChanges And HasUnoInterfaces(oDoc, &quot;com.sun.star.text.XTextDocument&quot;) Then
      oDisp = createUnoService(&quot;com.sun.star.frame.DispatchHelper&quot;)
      oDisp.executeDispatch(oDoc.getCurrentController().getFrame(), &quot;.uno:AcceptAllTrackedChanges&quot;, &quot;&quot;, 0, Array())
    End If
    If doIdx Then
      If HasUnoInterfaces(oDoc, &quot;com.sun.star.util.XRefreshable&quot;) Then oDoc.refresh()
      If HasUnoInterfaces(oDoc, &quot;com.sun.star.text.XDocumentIndexesSupplier&quot;) Then
        oIndexes = oDoc.getDocumentIndexes()
        For j = 0 To oIndexes.Count - 1
          oIndexes.getByIndex(j).update()
        Next j
      End If
    End If
  Loop
End Sub
</script:module>
